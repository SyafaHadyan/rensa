# Email package
RESEND_API_KEY=replace-with-resend-api-key

# Shared auth secret for verification/reset tokens
NEXTAUTH_SECRET=replace-with-shared-secret

# App URLs used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Senders and recipients
EMAIL_FROM=Rensa <no-reply@example.com>
NO_REPLY_EMAIL=no-reply@example.com
ADMIN_EMAIL=admin@example.com
CONTACT_NOTIFICATION_EMAIL=contact@example.com
BUG_REPORTS_EMAIL=bugs@example.com
DEV_TEAM_EMAIL=dev@example.com

